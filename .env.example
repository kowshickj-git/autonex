# ============================================================
# AUTONEX SOLUTIONS — environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://autonexsolutions.com

# ---- Gallery persistence driver ----
# "supabase" = production (Postgres + Object Storage)
# "local"    = development fallback (writes to ./.data + ./public/uploads)
GALLERY_DRIVER=local

# ---- Supabase (required when GALLERY_DRIVER=supabase) ----
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
DATABASE_URL=
STORAGE_URL=
STORAGE_BUCKET=gallery
# Service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
STORAGE_KEY=

# Hostnames allowed by next/image, comma separated
NEXT_PUBLIC_IMAGE_HOSTS=

# ---- Admin authentication ----
# Signing secret for the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_AUTH_SECRET=change-me-to-a-long-random-string
# The bootstrap owner. Always able to sign in, has no database row, and cannot
# be deleted from the Team screen - it is what stops an empty database from
# locking you out. Additional staff logins are added from /admin/team.
ADMIN_EMAIL=autonexsolutionss@gmail.com
# Display name for the bootstrap owner (optional, defaults to "Owner")
ADMIN_NAME=
# Either a plain password (dev only) ...
ADMIN_PASSWORD=
# ... or a scrypt hash produced by `npm run admin:hash` (preferred).
# Format: scrypt:<salt-b64>:<key-b64>  (colon-delimited - a "$" would be eaten
# by dotenv variable expansion and every login would silently fail).
ADMIN_PASSWORD_HASH=
# Session lifetime in hours
ADMIN_SESSION_HOURS=12

# ---- Upload limits ----
# Photos (JPG/PNG/WEBP/AVIF)
MAX_UPLOAD_MB=10
# Video (MP4 only, stored as uploaded - never re-encoded)
MAX_VIDEO_MB=100
# Audio (MP3 only)
MAX_AUDIO_MB=20
